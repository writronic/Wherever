<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld results</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@results@</string>
		<key>results</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld resultaat</string>
			<key>other</key>
			<string>%lld resultaten</string>
		</dict>
	</dict>
	<key>Read %lld of %lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$lld van %2$#@files@ gelezen</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld bestand</string>
			<key>other</key>
			<string>%2$lld bestanden</string>
		</dict>
	</dict>
	<key>Stopped after %lld of %lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Gestopt na %1$lld van %2$#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld bestand</string>
			<key>other</key>
			<string>%2$lld bestanden</string>
		</dict>
	</dict>
	<key>%lld files not downloaded</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld bestand niet gedownload</string>
			<key>other</key>
			<string>%lld bestanden niet gedownload</string>
		</dict>
	</dict>
	<key>%lld files in unsupported formats</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld bestand in een niet-ondersteunde indeling</string>
			<key>other</key>
			<string>%lld bestanden in niet-ondersteunde indelingen</string>
		</dict>
	</dict>
	<key>%lld disks are not indexed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@disks@</string>
		<key>disks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld schijf is niet geïndexeerd</string>
			<key>other</key>
			<string>%lld schijven zijn niet geïndexeerd</string>
		</dict>
	</dict>
	<key>%lld files skipped</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld bestand overgeslagen</string>
			<key>other</key>
			<string>%lld bestanden overgeslagen</string>
		</dict>
	</dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld onderdeel</string>
			<key>other</key>
			<string>%lld onderdelen</string>
		</dict>
	</dict>
	<key>Are you sure you want to open %lld items?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Weet je zeker dat je %#@items@ wilt openen?</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld onderdeel</string>
			<key>other</key>
			<string>%lld onderdelen</string>
		</dict>
	</dict>
	<key>Are you sure you want to show %lld items in Finder?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Weet je zeker dat je %#@items@ in Finder wilt tonen?</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld onderdeel</string>
			<key>other</key>
			<string>%lld onderdelen</string>
		</dict>
	</dict>
</dict>
</plist>
