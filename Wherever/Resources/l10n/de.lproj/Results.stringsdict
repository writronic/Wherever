<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld results</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@results@</string>
		<key>results</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Ergebnis</string>
			<key>other</key>
			<string>%lld Ergebnisse</string>
		</dict>
	</dict>
	<key>Read %lld of %lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$lld von %2$#@files@ gelesen</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld Datei</string>
			<key>other</key>
			<string>%2$lld Dateien</string>
		</dict>
	</dict>
	<key>Stopped after %lld of %lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Nach %1$lld von %2$#@files@ gestoppt</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld Datei</string>
			<key>other</key>
			<string>%2$lld Dateien</string>
		</dict>
	</dict>
	<key>%lld files not downloaded</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Datei nicht geladen</string>
			<key>other</key>
			<string>%lld Dateien nicht geladen</string>
		</dict>
	</dict>
	<key>%lld files in unsupported formats</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Datei in einem nicht unterstützten Format</string>
			<key>other</key>
			<string>%lld Dateien in nicht unterstützten Formaten</string>
		</dict>
	</dict>
	<key>%lld disks are not indexed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@disks@</string>
		<key>disks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Festplatte ist nicht indiziert</string>
			<key>other</key>
			<string>%lld Festplatten sind nicht indiziert</string>
		</dict>
	</dict>
	<key>%lld files skipped</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Datei übersprungen</string>
			<key>other</key>
			<string>%lld Dateien übersprungen</string>
		</dict>
	</dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Objekt</string>
			<key>other</key>
			<string>%lld Objekte</string>
		</dict>
	</dict>
	<key>Are you sure you want to open %lld items?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Möchtest du %#@items@ wirklich öffnen?</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Objekt</string>
			<key>other</key>
			<string>%lld Objekte</string>
		</dict>
	</dict>
	<key>Are you sure you want to show %lld items in Finder?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Möchtest du %#@items@ wirklich im Finder zeigen?</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Objekt</string>
			<key>other</key>
			<string>%lld Objekte</string>
		</dict>
	</dict>
</dict>
</plist>
