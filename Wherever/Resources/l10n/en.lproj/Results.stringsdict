<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld results</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@results@</string>
		<key>results</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld result</string>
			<key>other</key>
			<string>%lld results</string>
		</dict>
	</dict>
	<key>Read %lld of %lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Read %1$lld of %2$#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld file</string>
			<key>other</key>
			<string>%2$lld files</string>
		</dict>
	</dict>
	<key>Stopped after %lld of %lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Stopped after %1$lld of %2$#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld file</string>
			<key>other</key>
			<string>%2$lld files</string>
		</dict>
	</dict>
	<key>%lld files not downloaded</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld file not downloaded</string>
			<key>other</key>
			<string>%lld files not downloaded</string>
		</dict>
	</dict>
	<key>%lld files in unsupported formats</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld file in an unsupported format</string>
			<key>other</key>
			<string>%lld files in unsupported formats</string>
		</dict>
	</dict>
	<key>%lld disks are not indexed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@disks@</string>
		<key>disks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld disk is not indexed</string>
			<key>other</key>
			<string>%lld disks are not indexed</string>
		</dict>
	</dict>
	<key>%lld files skipped</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld file skipped</string>
			<key>other</key>
			<string>%lld files skipped</string>
		</dict>
	</dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld item</string>
			<key>other</key>
			<string>%lld items</string>
		</dict>
	</dict>
	<key>Are you sure you want to open %lld items?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Are you sure you want to open %#@items@?</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld item</string>
			<key>other</key>
			<string>%lld items</string>
		</dict>
	</dict>
	<key>Are you sure you want to show %lld items in Finder?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Are you sure you want to show %#@items@ in Finder?</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld item</string>
			<key>other</key>
			<string>%lld items</string>
		</dict>
	</dict>
</dict>
</plist>
