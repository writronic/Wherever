<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld results</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@results@</string>
		<key>results</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld wynik</string>
			<key>few</key>
			<string>%lld wyniki</string>
			<key>many</key>
			<string>%lld wyników</string>
			<key>other</key>
			<string>%lld wyniku</string>
		</dict>
	</dict>
	<key>Read %lld of %lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Przeczytano %1$lld z %2$#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld pliku</string>
			<key>few</key>
			<string>%2$lld plików</string>
			<key>many</key>
			<string>%2$lld plików</string>
			<key>other</key>
			<string>%2$lld pliku</string>
		</dict>
	</dict>
	<key>Stopped after %lld of %lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Zatrzymano po %1$lld z %2$#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld pliku</string>
			<key>few</key>
			<string>%2$lld plików</string>
			<key>many</key>
			<string>%2$lld plików</string>
			<key>other</key>
			<string>%2$lld pliku</string>
		</dict>
	</dict>
	<key>%lld files not downloaded</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld plik niepobrany</string>
			<key>few</key>
			<string>%lld pliki niepobrane</string>
			<key>many</key>
			<string>%lld plików niepobranych</string>
			<key>other</key>
			<string>%lld pliku niepobranego</string>
		</dict>
	</dict>
	<key>%lld files in unsupported formats</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld plik w nieobsługiwanym formacie</string>
			<key>few</key>
			<string>%lld pliki w nieobsługiwanych formatach</string>
			<key>many</key>
			<string>%lld plików w nieobsługiwanych formatach</string>
			<key>other</key>
			<string>%lld pliku w nieobsługiwanym formacie</string>
		</dict>
	</dict>
	<key>%lld disks are not indexed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@disks@</string>
		<key>disks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld dysk nie jest zindeksowany</string>
			<key>few</key>
			<string>%lld dyski nie są zindeksowane</string>
			<key>many</key>
			<string>%lld dysków nie jest zindeksowanych</string>
			<key>other</key>
			<string>%lld dysku nie jest zindeksowanego</string>
		</dict>
	</dict>
	<key>%lld files skipped</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld plik pominięty</string>
			<key>few</key>
			<string>%lld pliki pominięte</string>
			<key>many</key>
			<string>%lld plików pominiętych</string>
			<key>other</key>
			<string>%lld pliku pominiętego</string>
		</dict>
	</dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld rzecz</string>
			<key>few</key>
			<string>%lld rzeczy</string>
			<key>many</key>
			<string>%lld rzeczy</string>
			<key>other</key>
			<string>%lld rzeczy</string>
		</dict>
	</dict>
	<key>Are you sure you want to open %lld items?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Czy na pewno chcesz otworzyć %#@items@?</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld rzecz</string>
			<key>few</key>
			<string>%lld rzeczy</string>
			<key>many</key>
			<string>%lld rzeczy</string>
			<key>other</key>
			<string>%lld rzeczy</string>
		</dict>
	</dict>
	<key>Are you sure you want to show %lld items in Finder?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Czy na pewno chcesz pokazać %#@items@ w Finderze?</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld rzecz</string>
			<key>few</key>
			<string>%lld rzeczy</string>
			<key>many</key>
			<string>%lld rzeczy</string>
			<key>other</key>
			<string>%lld rzeczy</string>
		</dict>
	</dict>
</dict>
</plist>
