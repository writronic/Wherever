<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld results</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@results@</string>
		<key>results</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 件の結果</string>
		</dict>
	</dict>
	<key>Read %lld of %lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$lld / %2$#@files@ を読み取り済み</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%2$lld 件のファイル</string>
		</dict>
	</dict>
	<key>Stopped after %lld of %lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$lld / %2$#@files@ を読み取った後に停止</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%2$lld 件のファイル</string>
		</dict>
	</dict>
	<key>%lld files not downloaded</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>未ダウンロードのファイル %lld 件</string>
		</dict>
	</dict>
	<key>%lld files in unsupported formats</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>非対応のフォーマットのファイル %lld 件</string>
		</dict>
	</dict>
	<key>%lld disks are not indexed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@disks@</string>
		<key>disks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 個のディスクのインデックスは作成されていません</string>
		</dict>
	</dict>
	<key>%lld files skipped</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>スキップされたファイル %lld 件</string>
		</dict>
	</dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld項目</string>
		</dict>
	</dict>
	<key>Are you sure you want to open %lld items?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@を開いてもよろしいですか？</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld項目</string>
		</dict>
	</dict>
	<key>Are you sure you want to show %lld items in Finder?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@をFinderに表示してもよろしいですか？</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld項目</string>
		</dict>
	</dict>
</dict>
</plist>
