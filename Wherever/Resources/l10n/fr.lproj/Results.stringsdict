<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld results</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@results@</string>
		<key>results</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld résultat</string>
			<key>many</key>
			<string>%lld de résultats</string>
			<key>other</key>
			<string>%lld résultats</string>
		</dict>
	</dict>
	<key>Read %lld of %lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$lld sur %2$#@files@ lus</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld fichier</string>
			<key>many</key>
			<string>%2$lld de fichiers</string>
			<key>other</key>
			<string>%2$lld fichiers</string>
		</dict>
	</dict>
	<key>Stopped after %lld of %lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Arrêté après %1$lld sur %2$#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld fichier</string>
			<key>many</key>
			<string>%2$lld de fichiers</string>
			<key>other</key>
			<string>%2$lld fichiers</string>
		</dict>
	</dict>
	<key>%lld files not downloaded</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld fichier non téléchargé</string>
			<key>many</key>
			<string>%lld de fichiers non téléchargés</string>
			<key>other</key>
			<string>%lld fichiers non téléchargés</string>
		</dict>
	</dict>
	<key>%lld files in unsupported formats</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld fichier dans un format non pris en charge</string>
			<key>many</key>
			<string>%lld de fichiers dans des formats non pris en charge</string>
			<key>other</key>
			<string>%lld fichiers dans des formats non pris en charge</string>
		</dict>
	</dict>
	<key>%lld disks are not indexed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@disks@</string>
		<key>disks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld disque n’est pas indexé</string>
			<key>many</key>
			<string>%lld de disques ne sont pas indexés</string>
			<key>other</key>
			<string>%lld disques ne sont pas indexés</string>
		</dict>
	</dict>
	<key>%lld files skipped</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld fichier ignoré</string>
			<key>many</key>
			<string>%lld de fichiers ignorés</string>
			<key>other</key>
			<string>%lld fichiers ignorés</string>
		</dict>
	</dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld élément</string>
			<key>many</key>
			<string>%lld d’éléments</string>
			<key>other</key>
			<string>%lld éléments</string>
		</dict>
	</dict>
	<key>Are you sure you want to open %lld items?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Voulez-vous vraiment ouvrir %#@items@ ?</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld élément</string>
			<key>many</key>
			<string>%lld d’éléments</string>
			<key>other</key>
			<string>%lld éléments</string>
		</dict>
	</dict>
	<key>Are you sure you want to show %lld items in Finder?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Voulez-vous vraiment afficher %#@items@ dans le Finder ?</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld élément</string>
			<key>many</key>
			<string>%lld d’éléments</string>
			<key>other</key>
			<string>%lld éléments</string>
		</dict>
	</dict>
</dict>
</plist>
